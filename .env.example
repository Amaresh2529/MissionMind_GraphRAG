# Copy to .env (git-ignored) and fill in. Read by src/config.py.

# Neo4j instance to use. Use a FRESH instance for any run you will report:
# the legacy local database contains contaminated graph facts (see
# docs/research/05_Stage1_Audit_BasePaper_Plan.md, section 1.4).
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Local LLM served by Ollama and decoding settings used by every entry point
MISSIONMIND_LLM_MODEL=llama3
MISSIONMIND_LLM_TEMPERATURE=0
MISSIONMIND_LLM_SEED=42

# Sentence-transformer used for chunk embeddings and the vector index
MISSIONMIND_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional path overrides
# MISSIONMIND_DATA_DIR=data
# MISSIONMIND_RUNS_DIR=runs
